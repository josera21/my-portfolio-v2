---
/**
 * Legacy Play Console URL (accented í). Served as 200 with the same HTML so
 * Google's crawler sees the policy text even if it does not follow redirects.
 */
import LegalLayout from '../layouts/LegalLayout.astro';
import TridentPrivacyContent from '../components/legal/TridentPrivacyContent.astro';
import { privacyUrl, tridentLegal } from '../data/trident-legal';
---

<LegalLayout
	title="Política de Privacidad de Trident Game"
	description="Política de Privacidad de Trident Game (com.gdrink). No recopilamos, almacenamos, transmitimos ni compartimos datos personales ni de uso."
	canonical={privacyUrl}
>
	<p class="mb-6 rounded-sm border border-cyber-cyan/30 bg-cyber-cyan/10 p-4 text-sm text-zinc-200">
		URL canónica (sin tildes, recomendada para Google Play):
		<a class="font-mono text-cyber-cyan" href={tridentLegal.privacyPath}>{privacyUrl}</a>
	</p>
	<TridentPrivacyContent />
</LegalLayout>
