---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectFilter from '../components/react/ProjectFilter';
import {
	person,
	experience,
	storeApps,
	personalProjects,
	freelanceProjects,
	workShowcase,
	repoProjects,
	skillGroups,
	certifications,
	education,
	languages,
} from '../data/portfolio';

const workCategories = [
	{
		id: 'personal',
		heading: workShowcase.personal.title,
		description: workShowcase.personal.description,
		projects: personalProjects,
		accent: 'green' as const,
	},
	{
		id: 'freelance',
		heading: workShowcase.freelance.title,
		description: workShowcase.freelance.description,
		projects: freelanceProjects,
		accent: 'magenta' as const,
	},
];

const navLinks = [
	{ href: '#experience', label: 'Experience', hoverClass: 'hover:text-cyber-green' },
	{ href: '#apps', label: 'Apps', hoverClass: 'hover:text-cyber-cyan' },
	{ href: '#work', label: 'Work', hoverClass: 'hover:text-cyber-magenta' },
	{ href: '#projects', label: 'Projects', hoverClass: 'hover:text-cyber-green' },
	{ href: '#skills', label: 'Skills', hoverClass: 'hover:text-cyber-cyan' },
	{ href: '#contact', label: 'Contact', hoverClass: 'hover:text-cyber-magenta' },
] as const;
---

<Layout title={`${person.name} — Portfolio`} description={person.summary}>
	<header
		class="cyber-header-border sticky top-0 z-40 border-b border-cyber-green/25 bg-cyber-bg/90 backdrop-blur-md"
	>
		<div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
			<a
				href="#top"
				class="group shrink-0 font-mono text-sm font-medium tracking-wide text-cyber-cyan transition hover:text-cyber-green"
			>
				<span class="text-cyber-magenta/90">{'>'}</span>{' '}
				{person.name.split(' ')[0]}
				<span class="text-zinc-500 transition group-hover:text-cyber-green/80">.sys</span>
			</a>
			<button
				type="button"
				id="nav-toggle"
				class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm border border-cyber-green/30 bg-cyber-surface/80 p-2 text-cyber-green transition hover:border-cyber-cyan/45 hover:text-cyber-cyan md:hidden"
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label="Open navigation menu"
			>
				<span class="sr-only">Menu</span>
				<span class="flex w-4 flex-col gap-1" aria-hidden="true">
					<span class="h-0.5 w-full bg-current"></span>
					<span class="h-0.5 w-full bg-current"></span>
					<span class="h-0.5 w-full bg-current"></span>
				</span>
			</button>
			<nav
				class="hidden items-center gap-3 text-sm font-mono uppercase tracking-wider text-zinc-500 md:flex"
				aria-label="Main navigation"
			>
				{
					navLinks.flatMap((link, index) => {
						const items = [
							<a href={link.href} class:list={['transition', link.hoverClass]}>
								{link.label}
							</a>,
						];
						if (index > 0) {
							items.unshift(
								<span class="text-cyber-magenta/40" aria-hidden="true">
									/
								</span>,
							);
						}
						return items;
					})
				}
			</nav>
		</div>
		<nav
			id="mobile-nav"
			class="hidden border-t border-cyber-green/15 bg-cyber-bg/95 md:hidden"
			aria-label="Main navigation"
		>
			<ul class="mx-auto flex max-w-3xl flex-col gap-1 px-4 py-3 sm:px-6">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								data-nav-link
								class:list={[
									'block rounded-sm px-3 py-3 font-mono text-sm uppercase tracking-wider text-zinc-400 transition',
									link.hoverClass,
									'hover:bg-cyber-surface/60',
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</header>

	<script>
		const toggle = document.getElementById('nav-toggle');
		const panel = document.getElementById('mobile-nav');

		const setMenuOpen = (open: boolean) => {
			panel?.classList.toggle('hidden', !open);
			toggle?.setAttribute('aria-expanded', String(open));
			toggle?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
		};

		toggle?.addEventListener('click', () => {
			const isOpen = panel?.classList.contains('hidden') === false;
			setMenuOpen(!isOpen);
		});

		panel?.querySelectorAll('[data-nav-link]').forEach((link) => {
			link.addEventListener('click', () => setMenuOpen(false));
		});

		window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
			if (event.matches) setMenuOpen(false);
		});
	</script>

	<main id="top" class="mx-auto max-w-3xl px-4 pb-24 pt-16 sm:px-6">
		<section class="space-y-6" aria-labelledby="hero-heading">
			<p class="font-mono text-sm tracking-widest text-cyber-green/90">
				<span class="text-cyber-magenta">[</span> {person.title}{' '}
				<span class="text-cyber-magenta">]</span>
			</p>
			<h1
				id="hero-heading"
				class="font-display text-4xl font-bold uppercase tracking-tight text-white cyber-text-glow sm:text-5xl"
			>
				{person.name}
			</h1>
			<p class="max-w-2xl border-l-2 border-cyber-magenta/40 pl-4 text-lg leading-relaxed text-zinc-400">
				{person.summary}
			</p>
			<ul class="flex flex-wrap gap-3 text-sm">
				<li>
					<a
						href={person.github}
						class="cyber-glow-green inline-flex items-center gap-1.5 rounded-sm border border-cyber-green/35 bg-cyber-surface/80 px-3 py-2 font-mono text-xs uppercase tracking-wide text-cyber-green/90 transition hover:border-cyber-cyan/50 hover:text-cyber-cyan"
					>
						GitHub
					</a>
				</li>
				<li>
					<a
						href={person.linkedin}
						class="inline-flex items-center gap-1.5 rounded-sm border border-zinc-700/90 bg-cyber-surface/60 px-3 py-2 font-mono text-xs uppercase tracking-wide text-zinc-300 transition hover:border-cyber-magenta/45 hover:text-cyber-magenta"
					>
						LinkedIn
					</a>
				</li>
				<li>
					<a
						href={`mailto:${person.email}`}
						class="inline-flex items-center gap-1.5 rounded-sm border border-zinc-700/90 bg-cyber-surface/60 px-3 py-2 font-mono text-xs uppercase tracking-wide text-zinc-300 transition hover:border-cyber-cyan/45 hover:text-cyber-cyan"
					>
						Email
					</a>
				</li>
			</ul>
		</section>

		<section id="experience" class="mt-24 scroll-mt-24" aria-labelledby="exp-heading">
			<h2
				id="exp-heading"
				class="font-display text-xs font-semibold uppercase tracking-[0.25em] text-cyber-cyan/80 sm:text-sm"
			>
				<span class="text-cyber-magenta">//</span> Experience
			</h2>
			<ul class="mt-8 space-y-10">
				{
					experience.map((job) => (
						<li class="relative border-l-2 border-cyber-green/40 pl-6 before:absolute before:-left-[5px] before:top-1.5 before:h-2 before:w-2 before:rounded-full before:bg-cyber-green before:shadow-[0_0_10px_rgba(0,255,157,0.7)]">
							<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
								<h3 class="font-display text-lg font-semibold tracking-wide text-white">{job.company}</h3>
								<span class="font-mono text-xs text-cyber-magenta/85">{job.period}</span>
							</div>
							<p class="mt-1 font-mono text-sm text-cyber-green/85">{job.role}</p>
							<ul class="mt-3 list-none space-y-2 pl-0 text-sm leading-relaxed text-zinc-400">
								{job.highlights.map((h) => (
									<li class="flex gap-2 before:font-mono before:text-cyber-cyan/50 before:content-['>_']">
										<span>{h}</span>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</section>

		<section id="apps" class="mt-24 scroll-mt-24" aria-labelledby="apps-heading">
			<h2
				id="apps-heading"
				class="font-display text-xs font-semibold uppercase tracking-[0.25em] text-cyber-cyan/80 sm:text-sm"
			>
				<span class="text-cyber-magenta">//</span> Apps on the stores
			</h2>
			<p class="mt-3 max-w-2xl font-mono text-xs text-zinc-500 sm:text-sm">
				<span class="text-cyber-green/70">$</span> fetch(store_listings) — App Store, Google Play &amp; web
			</p>
			<ul class="mt-8 space-y-6">
				{
					storeApps.map((app) => (
						<li class="cyber-glow-green rounded-sm border border-cyber-green/20 bg-cyber-surface/50 p-6 backdrop-blur-sm">
							<h3 class="font-display text-xl font-semibold tracking-wide text-white">{app.name}</h3>
							<p class="mt-1 text-sm text-zinc-400">{app.tagline}</p>
							<p class="mt-3 text-sm leading-relaxed text-zinc-300">{app.context}</p>
							<p class="mt-2 font-mono text-xs text-cyber-magenta/75">{app.role}</p>
							{app.images && app.images.length > 0 ? (
								(() => {
									const mobileImages = app.images.filter((img) => img.variant === 'mobile');
									const desktopImages = app.images.filter((img) => img.variant === 'desktop');
									const hasMixedLayout = mobileImages.length > 0 && desktopImages.length > 0;

									if (hasMixedLayout) {
										return (
											<div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-start">
												<div class="mx-auto w-full max-w-[200px] shrink-0 sm:mx-0">
													{mobileImages.map((img) => (
														<figure class="overflow-hidden rounded-sm border border-cyber-cyan/15 bg-cyber-bg/60">
															<img
																src={img.src}
																alt={img.alt}
																loading="lazy"
																class="h-auto w-full object-contain"
															/>
														</figure>
													))}
												</div>
												<div class="flex min-w-0 flex-1 flex-col gap-3">
													{desktopImages.map((img) => (
														<figure class="overflow-hidden rounded-sm border border-cyber-cyan/15 bg-cyber-bg/60">
															<img
																src={img.src}
																alt={img.alt}
																loading="lazy"
																class="h-auto w-full object-contain"
															/>
														</figure>
													))}
												</div>
											</div>
										);
									}

									const isSingleMobile =
										app.images.length === 1 && app.images[0]?.variant === 'mobile';

									return (
										<div
											class:list={[
												'mt-5 grid gap-3',
												isSingleMobile
													? 'max-w-[200px] grid-cols-1'
													: app.images.length === 1
														? 'grid-cols-1'
														: 'sm:grid-cols-2',
											]}
										>
											{app.images.map((img) => (
												<figure class="overflow-hidden rounded-sm border border-cyber-cyan/15 bg-cyber-bg/60">
													<img
														src={img.src}
														alt={img.alt}
														loading="lazy"
														class="h-auto w-full object-contain"
													/>
												</figure>
											))}
										</div>
									);
								})()
							) : null}
							<div class="mt-4 flex flex-wrap gap-3">
								{app.links.map((link) => (
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex rounded-sm border border-cyber-cyan/35 bg-cyber-cyan/10 px-4 py-2 font-mono text-xs font-medium uppercase tracking-wide text-cyber-cyan transition hover:border-cyber-cyan/60 hover:bg-cyber-cyan/20 hover:shadow-[0_0_16px_rgba(0,240,255,0.2)]"
									>
										{link.label}
									</a>
								))}
							</div>
						</li>
					))
				}
			</ul>
		</section>

		<section id="work" class="mt-24 scroll-mt-24" aria-labelledby="work-heading">
			<h2
				id="work-heading"
				class="font-display text-xs font-semibold uppercase tracking-[0.25em] text-cyber-cyan/80 sm:text-sm"
			>
				<span class="text-cyber-magenta">//</span> Personal &amp; freelance work
			</h2>
			<p class="mt-3 max-w-2xl font-mono text-xs text-zinc-500 sm:text-sm">
				<span class="text-cyber-green/70">$</span> deploy(showcase) — case studies and project deep-dives
			</p>
			<div class="mt-8 grid gap-8 lg:grid-cols-2">
				{
					workCategories.map((category) => (
						<div class="flex flex-col">
							<h3
								class:list={[
									'font-mono text-xs font-medium uppercase tracking-wider',
									category.accent === 'green' ? 'text-cyber-green/90' : 'text-cyber-magenta/90',
								]}
							>
								{category.heading}
							</h3>
							<p class="mt-2 text-sm text-zinc-500">{category.description}</p>
							{category.projects.length > 0 ? (
								<ul class="mt-5 flex flex-1 flex-col gap-4">
									{category.projects.map((project) => (
										<li
											class:list={[
												'rounded-sm border bg-cyber-surface/50 p-5 backdrop-blur-sm',
												category.accent === 'green'
													? 'border-cyber-green/20 cyber-glow-green'
													: 'border-cyber-magenta/20 cyber-glow-magenta',
											]}
										>
											<h4 class="font-display text-lg font-semibold tracking-wide text-white">
												{project.name}
											</h4>
											<p class="mt-1 text-sm text-zinc-400">{project.tagline}</p>
											<p class="mt-3 text-sm leading-relaxed text-zinc-300">{project.description}</p>
											{project.role ? (
												<p class="mt-2 font-mono text-xs text-cyber-magenta/75">{project.role}</p>
											) : null}
											{project.images && project.images.length > 0 ? (
												<div
													class:list={[
														'mt-5 grid gap-3',
														project.images.length === 1 ? 'grid-cols-1' : 'sm:grid-cols-2',
													]}
												>
													{project.images.map((img) => (
														<figure class="overflow-hidden rounded-sm border border-cyber-cyan/15 bg-cyber-bg/60">
															<img
																src={img.src}
																alt={img.alt}
																loading="lazy"
																class="h-auto w-full object-contain"
															/>
														</figure>
													))}
												</div>
											) : null}
											{project.links && project.links.length > 0 ? (
												<div class="mt-4 flex flex-wrap gap-3">
													{project.links.map((link) => (
														<a
															href={link.href}
															target="_blank"
															rel="noopener noreferrer"
															class="inline-flex rounded-sm border border-cyber-cyan/35 bg-cyber-cyan/10 px-4 py-2 font-mono text-xs font-medium uppercase tracking-wide text-cyber-cyan transition hover:border-cyber-cyan/60 hover:bg-cyber-cyan/20 hover:shadow-[0_0_16px_rgba(0,240,255,0.2)]"
														>
															{link.label}
														</a>
													))}
												</div>
											) : null}
										</li>
									))}
								</ul>
							) : (
								<div
									class:list={[
										'mt-5 flex flex-1 flex-col items-center justify-center rounded-sm border border-dashed px-6 py-12 text-center backdrop-blur-sm',
										category.accent === 'green'
											? 'border-cyber-green/30 bg-cyber-green/5'
											: 'border-cyber-magenta/30 bg-cyber-magenta/5',
									]}
									role="status"
								>
									<p
										class:list={[
											'font-mono text-[10px] font-medium uppercase tracking-[0.35em] sm:text-xs',
											category.accent === 'green' ? 'text-cyber-green/80' : 'text-cyber-magenta/80',
										]}
									>
										Coming soon
									</p>
									<p class="mt-4 font-display text-base font-semibold tracking-wide text-white sm:text-lg">
										{category.heading}
									</p>
									<p class="mt-2 max-w-xs text-sm leading-relaxed text-zinc-500">
										Case studies and screenshots are on the way. Check back for updates.
									</p>
									<p class="mt-6 font-mono text-xs text-zinc-600">
										<span
											class:list={[
												category.accent === 'green' ? 'text-cyber-green/70' : 'text-cyber-magenta/70',
											]}
										>
											$
										</span>{' '}
										status --pending
										<span class="animate-pulse text-cyber-cyan">_</span>
									</p>
								</div>
							)}
						</div>
					))
				}
			</div>
		</section>

		<section id="projects" class="mt-24 scroll-mt-24" aria-labelledby="proj-heading">
			<h2
				id="proj-heading"
				class="font-display text-xs font-semibold uppercase tracking-[0.25em] text-cyber-cyan/80 sm:text-sm"
			>
				<span class="text-cyber-magenta">//</span> Selected repositories
			</h2>
			<p class="mt-3 max-w-2xl text-sm text-zinc-500">
				Curated from my GitHub account. Private repos are listed without a public code link.
			</p>
			<div class="mt-8">
				<ProjectFilter client:load projects={repoProjects} />
			</div>
		</section>

		<section id="skills" class="mt-24 scroll-mt-24" aria-labelledby="skills-heading">
			<h2
				id="skills-heading"
				class="font-display text-xs font-semibold uppercase tracking-[0.25em] text-cyber-cyan/80 sm:text-sm"
			>
				<span class="text-cyber-magenta">//</span> Skills
			</h2>
			<div class="mt-8 grid gap-8 sm:grid-cols-2">
				{
					skillGroups.map((g) => (
						<div class="rounded-sm border border-zinc-800/80 bg-cyber-elevated/40 p-4">
							<h3 class="font-mono text-xs font-medium uppercase tracking-wider text-cyber-green/90">{g.title}</h3>
							<ul class="mt-3 flex flex-wrap gap-2">
								{g.items.map((item) => (
									<li class="rounded-sm border border-zinc-700/60 bg-cyber-bg/80 px-2.5 py-1 font-mono text-xs text-zinc-400 transition hover:border-cyber-magenta/35 hover:text-cyber-magenta/90">
										{item}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-24" aria-labelledby="edu-heading">
			<h2
				id="edu-heading"
				class="font-display text-xs font-semibold uppercase tracking-[0.25em] text-cyber-cyan/80 sm:text-sm"
			>
				<span class="text-cyber-magenta">//</span> Education, certifications &amp; languages
			</h2>
			<div class="cyber-glow-magenta mt-6 rounded-sm border border-cyber-magenta/20 bg-cyber-surface/40 p-6">
				<p class="font-display font-medium tracking-wide text-white">{education.degree}</p>
				<p class="mt-1 text-sm text-zinc-400">{education.school}</p>
				<p class="mt-1 font-mono text-xs text-cyber-cyan/70">{education.period}</p>
			</div>
			<h3 class="mt-8 font-mono text-xs font-medium uppercase tracking-wider text-cyber-green/90">
				Certifications
			</h3>
			<ul class="mt-4 space-y-3">
				{
					certifications.map((cert) => (
						<li class="rounded-sm border border-zinc-800/80 bg-cyber-elevated/40 px-4 py-3">
							<p class="text-sm text-zinc-300">{cert.name}</p>
							<p class="mt-1 font-mono text-xs text-zinc-500">
								<span class="text-cyber-cyan/80">{cert.provider}</span>
								<span class="text-zinc-600"> · </span>
								{cert.period}
							</p>
						</li>
					))
				}
			</ul>
			<h3 class="mt-8 font-mono text-xs font-medium uppercase tracking-wider text-cyber-green/90">
				Languages
			</h3>
			<ul class="mt-4 space-y-2 text-sm text-zinc-400">
				{
					languages.map((l) => (
						<li class="font-mono text-xs sm:text-sm">
							<span class="text-cyber-green">{l.name}</span>
							<span class="text-zinc-600"> :: </span>
							{l.level}
						</li>
					))
				}
			</ul>
		</section>

		<section
			id="contact"
			class="mt-24 scroll-mt-24 border-t border-cyber-green/15 pt-12"
			aria-labelledby="contact-heading"
		>
			<h2
				id="contact-heading"
				class="font-display text-xs font-semibold uppercase tracking-[0.25em] text-cyber-cyan/80 sm:text-sm"
			>
				<span class="text-cyber-magenta">//</span> Contact
			</h2>
			<p class="mt-4 text-zinc-400">
				<a
					href={`mailto:${person.email}`}
					class="font-mono text-cyber-green transition hover:text-cyber-cyan hover:underline"
				>
					{person.email}
				</a>
				<span class="mx-2 text-cyber-magenta/50">·</span>
				<span class="font-mono text-sm text-zinc-500">{person.phone}</span>
			</p>
			<p class="mt-2 font-mono text-xs text-zinc-600">{person.location}</p>
		</section>
	</main>

	<SiteFooter />
</Layout>
