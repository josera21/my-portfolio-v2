---
import Layout from '../layouts/Layout.astro';
import ProjectFilter from '../components/react/ProjectFilter';
import {
	person,
	experience,
	storeApps,
	repoProjects,
	skillGroups,
	education,
	languages,
} from '../data/portfolio';
---

<Layout title={`${person.name} — Portfolio`} description={person.summary}>
	<header
		class="sticky top-0 z-40 border-b border-white/5 bg-bg/75 backdrop-blur-xl"
	>
		<div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
			<a
				href="#top"
				class="font-display text-sm font-semibold tracking-tight text-white transition hover:text-accent-light"
			>
				{person.name.split(' ')[0]} Camacaro
			</a>
			<nav class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm">
				<a href="#experience" class="nav-link">Experience</a>
				<a href="#apps" class="nav-link">Apps</a>
				<a href="#projects" class="nav-link">Projects</a>
				<a href="#skills" class="nav-link">Skills</a>
				<a href="#contact" class="nav-link">Contact</a>
			</nav>
		</div>
	</header>

	<main id="top" class="mx-auto max-w-3xl px-4 pb-24 pt-16 sm:px-6">
		<section class="animate-fade-in-up space-y-6" aria-labelledby="hero-heading">
			<p class="inline-flex items-center rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-sm font-medium text-accent-light">
				{person.title}
			</p>
			<h1
				id="hero-heading"
				class="font-display text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
			>
				<span class="hero-gradient-text">{person.name}</span>
			</h1>
			<p class="max-w-2xl text-lg leading-relaxed text-zinc-400">
				{person.summary}
			</p>
			<ul class="flex flex-wrap gap-3 pt-2">
				<li>
					<a href={person.github} class="btn-primary">
						GitHub
					</a>
				</li>
				<li>
					<a href={person.linkedin} class="btn-secondary">
						LinkedIn
					</a>
				</li>
				<li>
					<a href={`mailto:${person.email}`} class="btn-secondary">
						Email
					</a>
				</li>
			</ul>
		</section>

		<section id="experience" class="mt-24 scroll-mt-24" aria-labelledby="exp-heading">
			<h2 id="exp-heading" class="section-heading">Experience</h2>
			<ul class="mt-10 space-y-10">
				{
					experience.map((job) => (
						<li class="relative border-l border-white/10 pl-8 before:absolute before:-left-[5px] before:top-2 before:h-2.5 before:w-2.5 before:rounded-full before:border-2 before:border-accent before:bg-bg">
							<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
								<h3 class="font-display text-lg font-semibold text-white">{job.company}</h3>
								<span class="text-sm text-muted">{job.period}</span>
							</div>
							<p class="mt-1 text-sm font-medium text-accent-light">{job.role}</p>
							<ul class="mt-4 list-none space-y-2.5 pl-0 text-sm leading-relaxed text-zinc-400">
								{job.highlights.map((h) => (
									<li class="flex gap-3">
										<span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent/70" aria-hidden="true" />
										<span>{h}</span>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</section>

		<section id="apps" class="mt-24 scroll-mt-24" aria-labelledby="apps-heading">
			<h2 id="apps-heading" class="section-heading">Apps on the stores</h2>
			<p class="mt-4 max-w-2xl text-sm text-zinc-500">
				Production apps published on App Store, Google Play, and the web.
			</p>
			<ul class="mt-8 space-y-5">
				{
					storeApps.map((app) => (
						<li class="card p-6">
							<h3 class="font-display text-xl font-semibold text-white">{app.name}</h3>
							<p class="mt-2 text-sm leading-relaxed text-zinc-400">{app.tagline}</p>
							<p class="mt-2 text-sm font-medium text-accent-soft">{app.role}</p>
							<div class="mt-5 flex flex-wrap gap-3">
								{app.links.map((link) => (
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										class="btn-secondary text-xs"
									>
										{link.label}
									</a>
								))}
							</div>
						</li>
					))
				}
			</ul>
		</section>

		<section id="projects" class="mt-24 scroll-mt-24" aria-labelledby="proj-heading">
			<h2 id="proj-heading" class="section-heading">Selected repositories</h2>
			<p class="mt-4 max-w-2xl text-sm text-zinc-500">
				Curated from my GitHub account. Private repos are listed without a public code link.
			</p>
			<div class="mt-8">
				<ProjectFilter client:load projects={repoProjects} />
			</div>
		</section>

		<section id="skills" class="mt-24 scroll-mt-24" aria-labelledby="skills-heading">
			<h2 id="skills-heading" class="section-heading">Skills</h2>
			<div class="mt-10 grid gap-5 sm:grid-cols-2">
				{
					skillGroups.map((g) => (
						<div class="card p-5">
							<h3 class="font-display text-sm font-semibold text-white">{g.title}</h3>
							<ul class="mt-4 flex flex-wrap gap-2">
								{g.items.map((item) => (
									<li class="rounded-md border border-white/10 bg-bg/60 px-2.5 py-1 text-xs text-zinc-400 transition hover:border-accent/25 hover:text-zinc-200">
										{item}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-24" aria-labelledby="edu-heading">
			<h2 id="edu-heading" class="section-heading">Education &amp; languages</h2>
			<div class="card mt-8 p-6">
				<p class="font-display font-semibold text-white">{education.degree}</p>
				<p class="mt-1 text-sm text-zinc-400">{education.school}</p>
				<p class="mt-1 text-sm text-muted">{education.period}</p>
			</div>
			<ul class="mt-6 space-y-2 text-sm text-zinc-400">
				{
					languages.map((l) => (
						<li>
							<span class="font-medium text-zinc-200">{l.name}</span>
							<span class="text-zinc-600"> — </span>
							{l.level}
						</li>
					))
				}
			</ul>
		</section>

		<section
			id="contact"
			class="mt-24 scroll-mt-24 border-t border-white/5 pt-12"
			aria-labelledby="contact-heading"
		>
			<h2 id="contact-heading" class="section-heading">Contact</h2>
			<p class="mt-6 text-zinc-400">
				<a
					href={`mailto:${person.email}`}
					class="font-medium text-accent-light transition hover:text-highlight hover:underline"
				>
					{person.email}
				</a>
				<span class="mx-2 text-zinc-600">·</span>
				<span class="text-sm text-zinc-500">{person.phone}</span>
			</p>
			<p class="mt-2 text-sm text-muted">{person.location}</p>
		</section>
	</main>

	<footer class="border-t border-white/5 py-8 text-center text-xs text-zinc-600">
		Built with Astro &amp; React · {new Date().getFullYear()} · {person.name}
	</footer>
</Layout>
