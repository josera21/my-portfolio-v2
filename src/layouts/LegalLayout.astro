---
import Layout from './Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { person } from '../data/portfolio';
import { tridentLegal } from '../data/trident-legal';

type Props = {
	title: string;
	description: string;
	canonical: string;
};

const { title, description, canonical } = Astro.props;
---

<Layout title={title} description={description} lang="es" canonical={canonical}>
	<header
		class="cyber-header-border sticky top-0 z-40 border-b border-cyber-green/25 bg-cyber-bg/90 backdrop-blur-md"
	>
		<div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
			<a
				href="/"
				class="group shrink-0 font-mono text-sm font-medium tracking-wide text-cyber-cyan transition hover:text-cyber-green"
			>
				<span class="text-cyber-magenta/90">{'>'}</span>{' '}
				{person.name.split(' ')[0]}
				<span class="text-zinc-500 transition group-hover:text-cyber-green/80">.sys</span>
			</a>
			<nav class="flex items-center gap-3 text-sm font-mono uppercase tracking-wider text-zinc-500" aria-label="Documentos legales">
				<a href={tridentLegal.privacyPath} class="transition hover:text-cyber-green">Privacidad</a>
				<span class="text-cyber-magenta/40" aria-hidden="true">/</span>
				<a href={tridentLegal.termsPath} class="transition hover:text-cyber-cyan">Términos</a>
			</nav>
		</div>
	</header>

	<main class="legal-doc mx-auto max-w-3xl px-4 pb-24 pt-12 sm:px-6">
		<p class="font-mono text-sm tracking-widest text-cyber-green/90">
			<span class="text-cyber-magenta">[</span> {tridentLegal.appStoreName}{' '}
			<span class="text-cyber-magenta">]</span>
			<span class="text-zinc-600"> {tridentLegal.packageId}</span>
		</p>
		<slot />
	</main>

	<SiteFooter />
</Layout>

<style>
	.legal-doc :global(h1) {
		margin-top: 0.75rem;
	}

	.legal-doc :global(h2) {
		margin-top: 2.25rem;
		scroll-margin-top: 5rem;
	}

	.legal-doc :global(h3) {
		margin-top: 1.25rem;
	}

	.legal-doc :global(p),
	.legal-doc :global(li) {
		line-height: 1.7;
	}

	.legal-doc :global(ul) {
		margin-top: 0.75rem;
		list-style: disc;
		padding-left: 1.25rem;
	}

	.legal-doc :global(a) {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
